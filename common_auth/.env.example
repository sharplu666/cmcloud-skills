# 中国移动云盘 skills 配置（账号会话模式 / 任意出口 IP 可用）
# 复制为 .env 后填写：
#   cp .env.example .env
#
# ── 登录会话（由登录脚本产出）─────────────────────────────
#   生成: python common_auth/mcloud_login.py --account <手机号> --password <密码> --out common_auth/session.json
#   缺失/过期时重跑同一命令即可（token 有效期 30 天）。
#   相对路径按包根目录解析。
CM_CLOUD_SESSION_FILE=common_auth/session.json

# ── 应用名（决定可写根路径 /AI空间/<APP_NAME>）────────────
CM_CLOUD_APP_NAME=MClaw空间

# ── 可选参数 ─────────────────────────────────────────────
# 渠道号（默认 10000023）
# CM_CLOUD_APP_CHANNEL=
# CM_CLOUD_API_VERSION=
# 知识库 Open API 根地址（本包内无知识库 skill，通常无需配置）
# CM_CLOUD_HOST=
